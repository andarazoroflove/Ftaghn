#define MainForm 1000

VERSION ID 1000 "1.0"
APPLICATIONICONNAME ID 1000 "Ftaghn"

ICONFAMILYEX
BEGIN
    BITMAP "palmos/rsc/icon_lg_1.bmp" BPP 1 DENSITY 1
    BITMAP "palmos/rsc/icon_lg_8.bmp" BPP 8 DENSITY 2 TRANSPARENTINDEX 0
END

SMALLICONFAMILYEX
BEGIN
    BITMAP "palmos/rsc/icon_sm_1.bmp" BPP 1 DENSITY 1
    BITMAP "palmos/rsc/icon_sm_8.bmp" BPP 8 DENSITY 2 TRANSPARENTINDEX 0
END

FORM ID MainForm AT (0 0 160 160)
NOFRAME
NOSAVEBEHIND
USABLE
BEGIN
    TITLE "Ftaghn: Cosmic Horror Ataxx"
END
